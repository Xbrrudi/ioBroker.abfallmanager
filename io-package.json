{
  "common": {
    "name": "abfallmanager",
    "version": "0.21.5",
    "titleLang": {
      "de": "Abfallmanager",
      "en": "Waste Manager",
      "ru": "Менеджер вывоза отходов",
      "pt": "Gestor de resíduos",
      "nl": "Afvalbeheer",
      "fr": "Gestion des déchets",
      "it": "Gestione rifiuti",
      "es": "Gestor de residuos",
      "pl": "Menedżer odpadów",
      "uk": "Менеджер відходів",
      "zh-cn": "垃圾收集管理"
    },
    "desc": {
      "de": "Lokale Abfuhrtermine aus ICS und manuellen Einträgen",
      "en": "Local waste pickup schedule from ICS and manual entries",
      "ru": "График вывоза отходов из ICS и ручных записей",
      "pt": "Calendário local de recolha de resíduos via ICS e entradas manuais",
      "nl": "Lokale afvalophaaldagen via ICS en handmatige invoer",
      "fr": "Calendrier local de collecte des déchets via ICS et saisie manuelle",
      "it": "Calendario locale di raccolta rifiuti da ICS e inserimenti manuali",
      "es": "Calendario local de recogida de residuos mediante ICS y entradas manuales",
      "pl": "Lokalny harmonogram odbioru odpadów z ICS i wpisów ręcznych",
      "uk": "Місцевий графік вивезення відходів з ICS і ручних записів",
      "zh-cn": "通过 ICS 和手动录入管理本地垃圾收集日程"
    },
    "authors": [
      "Andre Rudat"
    ],
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "type": "date-and-time",
    "connectionType": "local",
    "dataSource": "push",
    "compact": true,
    "enabled": true,
    "messagebox": true,
    "adminUI": {
      "config": "json"
    },
    "icon": "abfallmanager.svg",
    "extIcon": "https://raw.githubusercontent.com/Xbrrudi/ioBroker.abfallmanager/main/admin/abfallmanager.svg",
    "readme": "",
    "tier": 3,
    "supportCustoms": false,
    "dependencies": [
      {
        "js-controller": ">=7.0.0"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=8.0.0"
      }
    ],
    "visWidgets": {
      "vis2AbfallmanagerWidgets": {
        "name": "vis2AbfallmanagerWidgets",
        "i18n": "component",
        "url": "abfallmanager/customWidgets.js",
        "bundlerType": "module",
        "components": [
          "WasteBinWidget"
        ]
      }
    },
    "restartAdapters": [
      "vis-2"
    ],
    "keywords": [
      "Abfall",
      "Müllabfuhr",
      "Abfuhrkalender",
      "ICS",
      "VIS-2",
      "waste collection",
      "calendar"
    ],
    "news": {
      "0.21.4": {
        "en": "Improve adapter metadata and publication checks",
        "de": "Adapter-Metadaten und Veröffentlichungsprüfungen verbessert"
      }
    },
    "licenseInformation": {
      "license": "MIT",
      "type": "free"
    }
  },
  "native": {
    "icsText": "",
    "manualEntries": [],
    "bins": [
      {
        "id": "rest",
        "name": "Restabfalltonne",
        "keywords": "Restabfall,Restmüll",
        "enabled": true,
        "color": "#4a4a4a"
      },
      {
        "id": "gelb",
        "name": "Wertstofftonne",
        "keywords": "Wertstoff,Gelbe Tonne,Gelber Sack",
        "enabled": true,
        "color": "#e8d122"
      },
      {
        "id": "bio",
        "name": "Biotonne",
        "keywords": "Bioabfall,Biotonne",
        "enabled": false,
        "color": "#81552e"
      },
      {
        "id": "papier",
        "name": "Papiertonne",
        "keywords": "Papier,Pappe",
        "enabled": false,
        "color": "#2269ae"
      }
    ],
    "daysBefore": 2,
    "hideHour": 18,
    "autoCleanup": true,
    "retentionDays": 1,
    "importedEntries": []
  },
  "objects": [],
  "instanceObjects": [],
  "version": "0.21.5"
}
